# 로컬 개발 (Phase 0~1): SQLite 파일 DB, 계정/자격증명 불필요
DATABASE_URL="file:./dev.db"

# AI 훅 초안 (docs/02-architecture.md §9). 없어도 렌더러는 빈 훅으로 정상 동작한다
# (그레이스풀 디그레이드 — AI는 가속기이지 단일 장애점이 아니다).
ANTHROPIC_API_KEY=

# ── 텔레그램 봇 (Phase 1) ───────────────────────────────────────────────
# BotFather에서 발급. 텔레그램은 현표의 밥줄 계정(카카오/무신사/Meta)과 무관한 별도 채널이라
# 이 토큰이 유출돼도 그 계정들에는 영향이 없다. 그래도 Vault/시크릿 매니저로 관리할 것.
TELEGRAM_BOT_TOKEN=

# 봇에 접근할 수 있는 chat id (쉼표 구분). **비워두면 봇은 모든 메시지를 거부한다(fail closed).**
# 봇 사용자명은 공개라 누구나 말을 걸 수 있고, 화이트리스트가 없으면 아무나 우리 게이트웨이로
# 무신사 요청을 시킬 수 있게 된다.
# 확인법: 봇에게 아무 메시지나 보낸 뒤 https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ALLOWED_CHAT_IDS=

# 프로덕션 webhook 전용. setWebhook의 secret_token과 같은 값을 넣는다.
# 로컬 폴링 개발에는 필요 없다.
TELEGRAM_WEBHOOK_SECRET=

# 복사 웹뷰 링크 생성용 공개 주소 (예: https://qurator.example.com).
# 비어 있으면 봇이 웹뷰 버튼을 붙이지 않고 코드블록 복사만 제공한다.
# 클립보드 API는 HTTPS(또는 localhost)에서만 동작하므로 http://<LAN IP> 는 쓰지 말 것.
PUBLIC_BASE_URL=

# ── 웹 접근 통제 (필수) ─────────────────────────────────────────────────
# 대시보드와 API는 카드 본문을 서빙하고, 그 안에는 큐레이터 링크가 원본 그대로 들어 있다
# (utm_term ULID 포함). 인증 없이 열어두면 검색봇·스크래퍼가 현표 실적으로 클릭을 쌓아
# 어뷰징으로 판정될 수 있다 — 게이트웨이를 아무리 잠가도 링크를 공개하면 무의미하다.
#
# APP_ACCESS_TOKEN: 대시보드 접근 암호. 첫 접속은 https://<주소>/?k=<이 값> 으로 하면
# 쿠키가 심어진다. **비어 있으면 웹 표면 전체가 503으로 차단된다(fail closed).**
# 생성: openssl rand -base64 32
APP_ACCESS_TOKEN=

# APP_SECRET: 복사 웹뷰 링크 서명(HMAC)에 쓴다. 16자 이상.
# 비어 있으면 봇이 웹뷰 버튼을 생략하고 코드블록 복사만 제공한다.
# 생성: openssl rand -base64 32
APP_SECRET=
