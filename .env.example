# ── 데이터베이스 (Supabase Postgres, 2026-09-13 SQLite → Postgres 전환) ─────────
# Supabase 프로젝트 → Settings → Database → Connection string에서 값을 가져온다.
#
# DATABASE_URL: Transaction pooler(포트 6543). 앱 런타임(Vercel 서버리스 함수)이 쓴다 —
# 함수 인스턴스가 늘어나도 PgBouncer가 커넥션을 모아 쓰기 때문에 커넥션 고갈이 안 난다.
DATABASE_URL="postgresql://postgres:<password>@<project-ref>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: prisma migrate 전용 — PgBouncer 트랜잭션 모드는 마이그레이션이 쓰는
# advisory lock·prepared statement를 지원하지 않는다.
# Session pooler(포트 5432, pooler 호스트)를 쓴다. "Direct connection"(db.<project-ref>.supabase.co)은
# IPv6 전용이라 IPv6이 없는 네트워크(흔한 가정용 회선 포함)에서 P1001로 접속 자체가 안 될 수 있다 —
# Session pooler는 IPv4를 지원해 이 문제가 없다.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<project-ref-region>.pooler.supabase.com:5432/postgres"

# 로컬 개발에서 Postgres 없이 옛 SQLite dev.db를 마지막으로 읽을 때만 쓴다
# (scripts/export-data.ts, docs/07-deploy.md 참고). 평소 개발/앱 실행에는 쓰이지 않는다.
# SQLITE_DATABASE_URL="file:./dev.db"

# AI 훅 초안 (docs/02-architecture.md §9). 없어도 렌더러는 빈 훅으로 정상 동작한다
# (그레이스풀 디그레이드 — AI는 가속기이지 단일 장애점이 아니다).
ANTHROPIC_API_KEY=

# 배포된 앱의 공개 주소 (예: https://qurator.vercel.app). 숏링크(/l/{code}) 절대 URL을 만들 때 쓴다.
# 클립보드 API는 HTTPS(또는 localhost)에서만 동작하므로 http://<LAN IP> 는 쓰지 말 것.
PUBLIC_BASE_URL=

# ── 웹 접근 통제 (필수) ─────────────────────────────────────────────────
# 대시보드와 API는 카드 본문을 서빙하고, 그 안에는 큐레이터 링크가 원본 그대로 들어 있다
# (utm_term ULID 포함). 인증 없이 열어두면 검색봇·스크래퍼가 현표 실적으로 클릭을 쌓아
# 어뷰징으로 판정될 수 있다 — 게이트웨이를 아무리 잠가도 링크를 공개하면 무의미하다.
#
# APP_ACCESS_TOKEN: 대시보드 접근 암호. 첫 접속은 https://<주소>/?k=<이 값> 으로 하면
# 쿠키가 심어진다(30일). 폰 홈 화면에 그 주소를 추가해 두면 이후엔 그냥 열린다.
# **비어 있으면 웹 표면 전체가 503으로 차단된다(fail closed).**
# 생성: openssl rand -base64 32
APP_ACCESS_TOKEN=
