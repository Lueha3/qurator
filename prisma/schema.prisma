// qurator (HoneyFlow) — Phase 0~1 스키마
// 정본: docs/02-architecture.md §3. 필드/enum은 정본과 동일하게 유지해
// Phase 2+ (발행 어댑터·헬스체커·딜 레이더)로 갈 때 스키마 변경이 없도록 한다.
//
// DB: Supabase Postgres (2026-09-13 전환 — 그 전엔 로컬 SQLite였다, Vercel 서버리스
// 배포와 함께 이관). 마이그레이션 이력은 docs/07-deploy.md 참고. creator_id가 이미 전
// 테이블 FK라 Phase 3(RLS 멀티테넌트) 전환도 그대로 이어진다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // 풀링 연결(PgBouncer, 포트 6543) — 서버리스 함수 다수가 동시에 열어도 커넥션이 안 마른다.
  url       = env("DATABASE_URL")
  // 비풀링 직접 연결(포트 5432) — 마이그레이션 전용. PgBouncer 트랜잭션 모드는 Prisma
  // 마이그레이션이 쓰는 advisory lock·prepared statement를 지원하지 않는다.
  directUrl = env("DIRECT_URL")
}

// ── creators ────────────────────────────────────────────────────────────
// 1차는 현표 1행이지만 처음부터 FK로 걸어 SaaS 확장 시 스키마 변경 0.
model Creator {
  id              String   @id @default(uuid())
  handle          String   @unique // 'maison_jenflox'
  curatorShopUrl  String? // musinsa.com/curator/s/{닉네임}
  bio             String? // 링크허브 상단 한 줄 소개 (docs/08 §3.3)
  toneProfile     String? // jsonb 대체: 말투 few-shot 예시, 금칙어 등 (JSON 문자열)
  sizeProfile     String? // {height, weight, usual_top, usual_bottom} (JSON 문자열)
  createdAt       DateTime @default(now())

  products Product[]
  deals    Deal[]

  @@map("creators")
}

// ── products ────────────────────────────────────────────────────────────
model Product {
  id              String   @id @default(uuid())
  /**
   * 상품이 시스템에 등록된 순서(DB 시퀀스, 자동 증가). 화면에 "등록순번"으로 보여주기 위한
   * 값이다(2026-09-20, 사용자 요청). 그리드 캡처는 vision-extract.ts 프롬프트가 화면을
   * 왼쪽 위→오른쪽, 줄 단위로 읽게 하고 captureGridItems가 그 배열 순서 그대로 순차 생성하므로,
   * 이 번호는 곧 "그리드에서 몇 번째 칸이었나"와 같다. 지켜보는 목록의 정렬(싸진 것 먼저)과는
   * 무관하게 각 상품에 고정으로 붙는다 — 목록이 어떻게 정렬돼도 번호로 원래 화면 위치를 되짚을 수 있다.
   */
  registrationNo  Int      @default(autoincrement())
  creatorId       String
  creator         Creator  @relation(fields: [creatorId], references: [id])

  musinsaGoodsNo  String? // URL의 /products/{번호}. 수동 입력 단계에서는 선택
  canonicalUrl    String // www.musinsa.com/products/{번호}
  brandName       String
  brandNameEn     String?
  productName     String
  styleCode       String? // 품번
  categoryPath    String? // ['상의','맨투맨'] JSON 문자열
  listPrice       Int // 정가(원)
  mainImageUrl    String? // 재게시 금지 — 내부 확인용만
  source          CaptureSource @default(PASTE)
  capturedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  variants       ProductVariant[]
  deals          Deal[]
  priceSnapshots PriceSnapshot[]
  watchItem      WatchItem?

  @@unique([creatorId, musinsaGoodsNo])
  @@map("products")
}

enum CaptureSource {
  EXTENSION
  PASTE
  RADAR
  SHARE
  SCREENSHOT // docs/06 — 스크린샷 Vision 캡처로 생성된 상품
}

// ── product_variants ────────────────────────────────────────────────────
model ProductVariant {
  id               String    @id @default(uuid())
  productId        String
  product          Product   @relation(fields: [productId], references: [id])

  colorName        String
  sizeName         String? // null = 색상 대표 행
  stockState       StockState @default(UNKNOWN)
  stockCheckedAt   DateTime?

  curatorLinks CuratorLink[]

  @@map("product_variants")
}

enum StockState {
  IN_STOCK
  LOW
  SOLDOUT
  UNKNOWN
}

// ── deals ───────────────────────────────────────────────────────────────
model Deal {
  id                String     @id @default(uuid())
  productId         String
  product           Product    @relation(fields: [productId], references: [id])
  creatorId         String
  creator           Creator    @relation(fields: [creatorId], references: [id])

  status            DealStatus @default(DRAFT) // draft→ready→published→expired→archived (정본 enum)

  // 승인 카드 상태 (docs/02 §6). Deal.status가 딜 자체의 생애주기라면,
  // approvalStage는 "카드 1장이 어느 단계에 있는가"다 — 후보→링크대기→발행승인.
  // (2026-09-14: 텔레그램 채팅·메시지 앵커와 pendingInput은 웹 전환과 함께 제거 — 웹 UI는
  //  어느 딜에 무엇을 입력하는지 화면이 이미 알고 있어 "대기 중인 입력" 개념이 필요 없다.)
  approvalStage     ApprovalStage @default(CANDIDATE)
  sourceUrlRaw      String? // 현표가 던진 원본 URL (정규화 전) — 감사·디버깅용

  // 파싱 출처와 채워진 필드 수 — 카드에 "정보를 못 읽었다/일부만 읽었다"를 정확히 표시하기 위해 보존한다.
  parseSource       String? // 'vision' | 'manual' | 'json-ld' | 'opengraph' | 'none'
  parseFieldCount   Int      @default(0)

  salePrice         Int?
  discountRate      Int? // %
  couponCode        String?
  couponDesc        String?
  couponExpiresAt   DateTime?
  finalPrice        Int? // 쿠폰 적용가. null이면 salePrice 사용
  endsAt            DateTime?

  /**
   * 링크허브 섹션 묶음 (docs/08 §3.3). JSON 문자열 배열 — 예: ["가을 아우터"].
   * 별도 Collection 테이블을 두지 않는 이유: 1인 사용에서 태그는 몇 개뿐이고,
   * 관리 화면이 필요할 만큼 자라면 그때 테이블로 승격해도 늦지 않다.
   */
  tags              String?

  hookLine          String? // AI 초안 → 사람 수정본
  curatorNote       String? // 사이즈 코멘트 등 (168/62 M 정사이즈)
  aiScore           Float?
  priority          Int      @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  curatorLinks CuratorLink[]
  contentCards ContentCard[]
  posts        Post[]
  shortLinks   ShortLink[]

  @@map("deals")
}

enum DealStatus {
  DRAFT
  READY
  PUBLISHED
  EXPIRED
  ARCHIVED
}

enum ApprovalStage {
  CANDIDATE // 봇이 상품을 파싱해 후보 카드를 띄운 상태
  AWAITING_LINK // 현표가 [관심]을 눌러 큐레이터 링크 붙여넣기를 기다리는 상태
  READY_TO_PUBLISH // 링크 수신 → 카드 렌더 완료, 승인 대기
  APPROVED // 승인됨 (Phase 1에서는 카톡 텍스트 전달까지가 전부)
  SKIPPED // 현표가 스킵 — 스코어링 네거티브 라벨(Phase 3)
}

// ── curator_links ───────────────────────────────────────────────────────
// 큐레이터센터에서 "사람이 수동 생성"한 링크의 저장소. API 생성 불가가 전제(무신사 약관/API 부재).
model CuratorLink {
  id              String   @id @default(uuid())
  dealId          String
  deal            Deal     @relation(fields: [dealId], references: [id])
  variantId       String? // null = 상품 대표 링크 (기본값 — 실사용성 검증 반영: 색상별은 옵트인)
  variant         ProductVariant? @relation(fields: [variantId], references: [id])

  rawUrl          String // 붙여넣은 원본 (utm_term ULID 포함)
  ulid            String? // rawUrl에서 파싱한 utm_term — 정산 매칭 키
  isDefault       Boolean  @default(true) // 상품 대표 링크 여부

  health          LinkHealth @default(UNCHECKED)
  healthCheckedAt DateTime?
  /** 연속 품절 관측 횟수. 일시적 품절(플랩)로 살아있는 링크를 죽이지 않기 위한 카운터 */
  soldoutStreak   Int      @default(0)
  /** 첫 헬스체크 시각. 발행 시각과 동기화되지 않도록 랜덤 오프셋(1~6h)을 더해 정한다 */
  healthCheckAfter DateTime?

  createdAt       DateTime @default(now())

  shortLinks ShortLink[]

  @@map("curator_links")
}

enum LinkHealth {
  OK
  SOLDOUT
  COUPON_EXPIRED
  DEAD
  UNCHECKED
}

// ── content_cards ───────────────────────────────────────────────────────
// 렌더링 결과물. Deal당 채널당 활성 1개, 불변(immutable) + 버전.
model ContentCard {
  id                String   @id @default(uuid())
  dealId            String
  deal              Deal     @relation(fields: [dealId], references: [id])

  channel           Channel
  version           Int      @default(1)

  bodyText          String // 최종 텍스트 (고지 포함)
  charCount         Int
  disclosureOk      Boolean // false면 발행/복사 API가 거부 (불변식)
  truncated         Boolean  @default(false) // 채널 글자수 제약으로 축약 사다리가 적용됐는지
  warnings          String? // 렌더러가 남긴 경고 메시지 배열 (JSON 문자열)
  aiGeneratedFields String? // ['hook_line'] JSON 문자열 — 사람 검토 필요 필드 추적
  approvedAt        DateTime?

  createdAt         DateTime @default(now())

  posts Post[]

  @@unique([dealId, channel, version])
  @@map("content_cards")
}

enum Channel {
  KAKAO_OPEN
  THREADS
  INSTAGRAM_COMMENT
  NOTION
}

// ── posts ───────────────────────────────────────────────────────────────
// 발행 이력. 반자동 채널도 "복사됨"을 기록해 재입력 누락을 없앤다.
model Post {
  id             String      @id @default(uuid())
  contentCardId  String
  contentCard    ContentCard @relation(fields: [contentCardId], references: [id])
  dealId         String
  deal           Deal        @relation(fields: [dealId], references: [id])

  channel        Channel
  mode           PostMode
  status         PostStatus  @default(PENDING)
  publishedAt    DateTime?

  @@map("posts")
}

enum PostMode {
  AUTO_API
  SEMI_COPIED
  SEMI_SENT_TO_ME
}

enum PostStatus {
  PENDING
  SENT
  CONFIRMED
  FAILED
}

// ── short_links ─────────────────────────────────────────────────────────
// docs/02-architecture.md §10.1. 채널별 클릭 계측의 소유권을 확보하고, 품절 시
// 과거 게시물의 링크까지 한 번에 구제하기 위한 앞단 리다이렉트.
//
// 불변식 (docs/03 §5.2·§5.3):
//   - targetUrl은 큐레이터 링크 **원형 무변조**다. 파라미터를 건드리면 링크 변조 금지 조항 위반.
//   - state=DEAD인 링크는 절대 '다른 상품의 커미션 링크'로 자동 착지시키지 않는다.
//     반드시 비커미션 안내 페이지로 보내고, 대안 딜은 사용자가 명시적으로 클릭해야 한다.
model ShortLink {
  id            String      @id @default(uuid())
  code          String      @unique // base62 7자
  dealId        String
  deal          Deal        @relation(fields: [dealId], references: [id])
  curatorLinkId String
  curatorLink   CuratorLink @relation(fields: [curatorLinkId], references: [id])

  /**
   * 어느 지면에 실린 링크인지 — 딜×지면당 1개를 발급해 채널 기여를 최초 클릭 시점에 확정한다.
   * 'hub' | 'notion' | 'kakao_open' | 'threads' … (Channel enum + 링크허브)
   *
   * nullable로 두지 않는 이유: SQL에서 NULL은 서로 다른 값으로 취급되어 복합 유니크가
   * 실제로 강제되지 않는다 — 같은 딜에 hub 링크가 여러 개 생겨도 DB가 막지 못한다.
   */
  surface   String         @default("hub")
  targetUrl String // 큐레이터 링크 원본. 절대 수정하지 않는다.
  state     ShortLinkState @default(ACTIVE)
  createdAt DateTime       @default(now())

  clicks ClickEvent[]

  @@unique([dealId, curatorLinkId, surface])
  @@map("short_links")
}

enum ShortLinkState {
  ACTIVE
  DEAD // 품절·쿠폰 만료 — 안내 페이지로 보낸다
}

// ── click_events ────────────────────────────────────────────────────────
// IP는 저장하지 않는다(개인정보 최소화). 봇 판정에만 쓰고 즉시 버린다.
model ClickEvent {
  id          String    @id @default(uuid())
  shortLinkId String
  shortLink   ShortLink @relation(fields: [shortLinkId], references: [id])
  ts          DateTime  @default(now())
  referer     String?
  /** 'human' | 'bot' — UA 기반 1차 분류. 봇 클릭은 성과 집계에서 제외한다. */
  uaClass     String    @default("human")
  country     String?

  @@index([shortLinkId, ts])
  @@map("click_events")
}

// ── hub_visits ──────────────────────────────────────────────────────────
// 링크허브 페이지뷰. 성과 탭의 "허브 CTR"(방문 대비 클릭) 분모다 (docs/08 §3.4).
// ClickEvent와 같은 규율을 따른다: IP·referer·개인정보를 저장하지 않고, 봇 분류만 남긴다.
model HubVisit {
  id      String   @id @default(uuid())
  ts      DateTime @default(now())
  /** 'human' | 'bot' — UA 기반 1차 분류. 봇 방문은 집계에서 제외한다. */
  uaClass String   @default("human")

  @@index([ts])
  @@map("hub_visits")
}

// ── audit_log ───────────────────────────────────────────────────────────
// docs/03-account-safety.md §11. append-only. 목적:
//   ① 플랫폼이 계정을 제재했을 때 "전부 사람이 승인한 공식 API 사용"임을 입증
//   ② 공정위 이슈 시 고지문 삽입 이력 입증
// 절대 규칙: 토큰·개인정보를 기록하지 않는다. 수정·삭제 경로를 만들지 않는다.
model AuditLog {
  id              String   @id @default(uuid())
  ts              DateTime @default(now())
  actor           Actor // 사람이 한 일인가, 시스템이 한 일인가
  action          String // 'deal.captured' | 'deal.approved' | 'card.copied' | 'fetch.blocked' 등
  channel         String? // 해당되는 경우의 채널
  approvalRef     String? // 승인 카드 스냅샷 → 승인 이벤트 → 페이로드 해시를 묶는 체인 키
  payloadHash     String? // SHA-256 — 무엇을 승인했는지의 위변조 불가 증적
  payloadSnapshot String? // 승인 시점의 본문 스냅샷 (JSON 문자열)
  responseCode    Int? // 외부 API 응답 코드
  responseId      String? // 플랫폼이 반환한 게시물 ID
  detail          String? // 사람이 읽을 요약
  /**
   * **누가** 했는지 — docs/03 §7.2. 쓰는 손이 둘이 되면서(협업자 + 현표) `actor: HUMAN`만으로는
   * "누가 승인했지"를 답할 수 없게 됐다. 패스키로 로그인했을 때만 채워진다(그 이름이 곧 기기 이름).
   * `?k=` 토큰 세션은 누구인지 알 방법이 없으므로 null이다 — 모르면 모른다고 둔다.
   */
  actorName       String?

  @@index([ts])
  @@index([approvalRef])
  @@map("audit_log")
}

enum Actor {
  HUMAN
  SYSTEM
}

// ── fetch_log ───────────────────────────────────────────────────────────
// Fetch Gateway를 통과한 모든 아웃바운드 요청의 기록. 본문은 저장하지 않는다(docs/03 §11).
// "사용자가 명시적으로 요청한 단발 fetch"임을 입증하는 증적이기도 하다 — trigger 필드가 그것.
model FetchLog {
  id           String      @id @default(uuid())
  ts           DateTime    @default(now())
  url          String // 정규화된 요청 URL (ULID/utm 파라미터는 애초에 게이트웨이가 차단)
  host         String
  trigger      FetchTrigger // 무엇이 이 요청을 유발했는가
  outcome      FetchOutcome
  responseCode Int?
  durationMs   Int?
  bytes        Int?
  detail       String? // 차단 사유 등

  @@index([ts])
  @@index([host, ts])
  @@map("fetch_log")
}

enum FetchTrigger {
  USER_URL // 현표가 봇/폼에 직접 던진 URL (Phase 1의 유일한 경로)
  HEALTH_CHECK // 링크 헬스체커 (Phase 2)
  RADAR // 자동 발굴 크롤러 (Phase 3)
  ROBOTS // robots.txt 자체 조회
  WATCH // BF 워치 러너 — VPS 전용, docs/05 §3.2 규율 (W2에서 가동)
}

enum FetchOutcome {
  OK
  BLOCKED_POLICY // 게이트웨이 하드 가드가 막음 (ULID URL, 사설 IP, 호스트 화이트리스트 위반 등)
  BLOCKED_ROBOTS // robots.txt Disallow
  BLOCKED_BUDGET // 레이트리밋/일일 예산 소진
  BLOCKED_CIRCUIT // 서킷 오픈 상태 (이전 차단 감지로 정지 중)
  BOT_CHALLENGE // 캡차·차단 페이지 감지
  HTTP_ERROR
  TIMEOUT
  NETWORK_ERROR
}

// ── circuit_state ───────────────────────────────────────────────────────
// 소스(호스트)별 서킷브레이커. docs/03 §6.2 — 자동 정지, 수동 재개 비대칭.
model CircuitState {
  host          String    @id
  state         Circuit   @default(HEALTHY)
  pausedUntil   DateTime? // 백오프 종료 시각. BLOCKED는 pausedUntil이 없고 사람이 풀어야 한다
  reason        String?
  consecutiveFailures Int  @default(0)
  updatedAt     DateTime  @updatedAt

  @@map("circuit_state")
}

enum Circuit {
  HEALTHY
  DEGRADED // 백오프 중 — 시간이 지나면 자동 회복
  BLOCKED // 차단 감지 — 자동 재개 없음, 사람이 해제해야 함
}

// ── price_snapshots ─────────────────────────────────────────────────────
// docs/05-price-watch.md §4.3 — 상품 가격의 시계열 기록. BF 연도별 비교의 데이터 기반.
// USER_URL·HEALTH_CHECK 스냅샷은 이미 내려받은 페이지의 파싱 결과를 저장할 뿐이라
// 추가 아웃바운드 요청이 0건이다. WATCH만 신규 요청을 만들며 docs/05 §3.2 규율을 따른다.
// 저장 범위는 가격 필드만 — 설명문·이미지를 축적하지 않는다 (docs/03 §4.2 저작권 안전선).
model PriceSnapshot {
  id          String         @id @default(uuid())
  productId   String
  product     Product        @relation(fields: [productId], references: [id])
  capturedAt  DateTime       @default(now())
  listPrice   Int? // 정가
  salePrice   Int? // 행사가(판매가)
  couponPrice Int? // 공개 상품쿠폰가 — 파서 확장(W3) 전에는 항상 null
  /**
   * 화면에 찍힌 할인율(%) — 좋아요 목록 그리드 캡처에서만 채워진다(docs/06 §4.6).
   * 기준가 대비 실할인율(price-analysis.ts가 계산)과는 다른 값이다. 2026-09-20 추가:
   * 그 전에는 vision이 읽어와도 저장할 자리가 없어 캡처 직후 버려졌다 — 실사용자 제보로 발견.
   */
  discountRateShown Int?
  source      SnapshotSource
  eventTag    String? // "BF2025" 등. 이벤트 창(policy watch.event.*) 안이면 자동 스탬핑, MANUAL은 직접 지정
  note        String? // MANUAL 입력 근거 (예: "작년 스크린샷 기준")

  @@index([productId, capturedAt])
  @@map("price_snapshots")
}

enum SnapshotSource {
  USER_URL // 봇에 링크를 던진 시점의 파싱 결과 (피기백)
  HEALTH_CHECK // 헬스체커가 내려받은 페이지의 파싱 결과 (피기백)
  WATCH // VPS 워치 러너의 정기 스냅샷 (W2)
  MANUAL // 사람이 직접 입력 (작년 BF가 등)
  SCREENSHOT // docs/06 — 스크린샷 Vision 추출 결과 (실질적인 1차 입력 경로)
}

// ── watch_items ─────────────────────────────────────────────────────────
// BF 추적 대상 — 현표가 명시적으로 등록한 상품만. 발굴·카탈로그 수집은 하지 않는다.
// 상한(기본 30)은 docs/05 §3.2. 자동 만료는 없다 — 종료는 /unwatch로 사람이 직접 한다
// (2026-09-10 변경, watch.ts 참고).
model WatchItem {
  id        String   @id @default(uuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime // 사실상 만료되지 않는 값(약 100년 뒤) — active만이 실제 종료 신호다
  active    Boolean  @default(true)

  /**
   * 첫 조회 가능 시각. 등록 시각 + 랜덤 1~6h.
   * 등록과 동시에 조회하면 "현표가 관심을 표한 순간"과 요청 시각이 붙어 지문이 된다 (docs/03 §4.3).
   */
  checkAfter    DateTime
  /**
   * 마지막 조회 시각. **스냅샷으로 대체할 수 없다** — 파싱에 실패하면 스냅샷이 남지 않으므로
   * 스냅샷을 기준으로 삼으면 그 상품이 영원히 "미조회"로 남아 매 사이클 재조회된다(무한 두드림).
   */
  lastCheckedAt DateTime?

  @@map("watch_items")
}

// ── policy ──────────────────────────────────────────────────────────────
// docs/02-architecture.md §13 정책 시트의 DB 형태. "여기 없는 수치를 코드에 하드코딩하지 않는다."
// 코드는 기본값(하드캡)을 함께 갖고, 둘 중 더 보수적인 값을 사용한다(이중화).
model Policy {
  key       String   @id
  value     String // 숫자/불리언도 문자열로 저장 (SQLite/Postgres 공통)
  note      String?
  updatedAt DateTime @updatedAt

  @@map("policy")
}

// ── push_subscriptions ──────────────────────────────────────────────────
// 웹 푸시 구독 — docs/08 §4.0.5 (V2-G). 현표의 폰 한 대가 사실상 전부지만, 폰을 바꾸거나
// PC에서도 켜면 여러 건이 된다. 브라우저가 주는 endpoint가 곧 식별자라 그것으로 중복을 막는다.
//
// 저장하는 값은 **브라우저가 만들어 준 공개 구독 정보**뿐이다(누구인지·어디 있는지가 아니다).
// 그래도 이 세 값을 쥐면 그 폰에 알림을 보낼 수 있으므로 공개 표면에 절대 내보내지 않는다.
model PushSubscription {
  id       String @id @default(uuid())
  endpoint String @unique // 푸시 서비스(Apple/Google) 주소. 기기당 1개
  p256dh   String // 본문 암호화용 공개키
  auth     String // 본문 암호화용 인증 시크릿

  label     String? // "아이폰" 같은 사람이 알아볼 이름 — UA에서 추정해 넣는다
  createdAt DateTime  @default(now())
  lastOkAt  DateTime? // 마지막으로 전송에 성공한 시각
  failCount Int       @default(0) // 연속 실패. 만료(404/410)는 즉시 삭제하므로 이건 일시 장애용

  @@map("push_subscriptions")
}

// ── passkeys ────────────────────────────────────────────────────────────
// Face ID 로그인 — docs/03 §7.1. `?k=` 토큰은 "알고 있으면 누구나"인 비밀번호라,
// 주소·리퍼러·스크린샷·어깨너머로 샐 경로가 계속 있다. 패스키는 기기 안 보안 요소에서
// 나가지 않는 개인키로 서명하므로 **훔쳐갈 문자열 자체가 없다**.
//
// 등록은 반드시 이미 로그인된 상태에서만 된다(게이트 뒤 경로). 그렇지 않으면
// 아무나 자기 얼굴을 등록해 이 앱의 주인이 된다.
model Passkey {
  id           String  @id @default(uuid())
  credentialId String  @unique // 인증기가 준 자격증명 ID (base64url)
  publicKey    String // COSE 공개키 (base64url). 개인키는 기기를 떠나지 않는다
  /**
   * 서명 카운터. 인증기가 매번 올려 보내며, 값이 되돌아가면 복제된 자격증명 신호다.
   * 아이클라우드 키체인 패스키는 항상 0이라 그 경우 이 검사가 사실상 무효다 — 그래서
   * 이것만 믿지 않는다(서명 검증이 본선이다).
   */
  counter      Int     @default(0)
  transports   String? // JSON 배열 — 다음 로그인에서 브라우저에 힌트로 준다
  label        String? // "아이폰" 같은 사람이 알아볼 이름

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@map("passkeys")
}

// WebAuthn 챌린지. **서버가 낸 것을 그대로 돌려받았는지**가 재전송 공격을 막는 전부라,
// 클라이언트가 보낸 값을 믿을 수 없고 서버 어딘가에 남아 있어야 한다.
// 쿠키가 아니라 DB에 두는 이유: 서버리스는 인스턴스가 여러 개고, 쓴 챌린지를
// **한 번 쓰면 지워야** 하기 때문이다(쿠키로는 "이미 썼다"를 강제할 수 없다).
model AuthChallenge {
  id        String   @id @default(uuid())
  challenge String   @unique
  purpose   String // "register" | "login"
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("auth_challenges")
}

// ── passkey_invites ─────────────────────────────────────────────────────
// 1회용 등록 초대 — docs/03 §7.2.
//
// 패스키 등록은 게이트 뒤라 원래는 `?k=<APP_ACCESS_TOKEN>`을 한 번 써야 한다. 그런데 그건
// **영구 비밀번호를 통째로 넘기는 것**이다. 협업자에게 등록만 시키려고 마스터 토큰을 주는 건
// 과하다 — 그래서 "패스키 등록 딱 한 번"만 되는 짧은 코드를 따로 낸다.
//
// 이 코드는 게이트를 여는 유일한 열쇠이므로: 32바이트 난수, 10분, **1회용**.
model PasskeyInvite {
  id        String    @id @default(uuid())
  code      String    @unique // 32바이트 난수 base64url
  note      String? // "현표" 같은 누구에게 보냈는지
  expiresAt DateTime
  usedAt    DateTime? // 쓰이면 채워진다. null이 아니면 두 번 쓸 수 없다
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@map("passkey_invites")
}
