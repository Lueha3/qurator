// qurator (HoneyFlow) — Phase 0~1 스키마
// 정본: docs/02-architecture.md §3. 필드/enum은 정본과 동일하게 유지해
// Phase 2+ (발행 어댑터·헬스체커·딜 레이더)로 갈 때 스키마 변경이 없도록 한다.
//
// DB: SQLite (Phase 0 로컬 개발용 — Supabase 계정 없이 즉시 실행 가능).
// provider만 "postgresql"로 바꾸고 DATABASE_URL을 Supabase 연결 문자열로 교체하면
// Phase 3(RLS 멀티테넌트) 전환이 그대로 된다 (creator_id가 이미 전 테이블 FK).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── creators ────────────────────────────────────────────────────────────
// 1차는 현표 1행이지만 처음부터 FK로 걸어 SaaS 확장 시 스키마 변경 0.
model Creator {
  id              String   @id @default(uuid())
  handle          String   @unique // 'maison_jenflox'
  curatorShopUrl  String? // musinsa.com/curator/s/{닉네임}
  toneProfile     String? // jsonb 대체: 말투 few-shot 예시, 금칙어 등 (JSON 문자열)
  sizeProfile     String? // {height, weight, usual_top, usual_bottom} (JSON 문자열)
  createdAt       DateTime @default(now())

  products Product[]
  deals    Deal[]

  @@map("creators")
}

// ── products ────────────────────────────────────────────────────────────
model Product {
  id              String   @id @default(uuid())
  creatorId       String
  creator         Creator  @relation(fields: [creatorId], references: [id])

  musinsaGoodsNo  String? // URL의 /products/{번호}. 수동 입력 단계에서는 선택
  canonicalUrl    String // www.musinsa.com/products/{번호}
  brandName       String
  brandNameEn     String?
  productName     String
  styleCode       String? // 품번
  categoryPath    String? // ['상의','맨투맨'] JSON 문자열
  listPrice       Int // 정가(원)
  mainImageUrl    String? // 재게시 금지 — 내부 확인용만
  source          CaptureSource @default(PASTE)
  capturedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  variants       ProductVariant[]
  deals          Deal[]
  priceSnapshots PriceSnapshot[]
  watchItem      WatchItem?

  @@unique([creatorId, musinsaGoodsNo])
  @@map("products")
}

enum CaptureSource {
  EXTENSION
  PASTE
  RADAR
  SHARE
}

// ── product_variants ────────────────────────────────────────────────────
model ProductVariant {
  id               String    @id @default(uuid())
  productId        String
  product          Product   @relation(fields: [productId], references: [id])

  colorName        String
  sizeName         String? // null = 색상 대표 행
  stockState       StockState @default(UNKNOWN)
  stockCheckedAt   DateTime?

  curatorLinks CuratorLink[]

  @@map("product_variants")
}

enum StockState {
  IN_STOCK
  LOW
  SOLDOUT
  UNKNOWN
}

// ── deals ───────────────────────────────────────────────────────────────
model Deal {
  id                String     @id @default(uuid())
  productId         String
  product           Product    @relation(fields: [productId], references: [id])
  creatorId         String
  creator           Creator    @relation(fields: [creatorId], references: [id])

  status            DealStatus @default(DRAFT) // draft→ready→published→expired→archived (정본 enum)

  // 텔레그램 승인 카드 상태 (docs/02 §6). Deal.status가 딜 자체의 생애주기라면,
  // approvalStage는 "카드 1장이 어느 단계에 있는가"다 — 후보→링크대기→발행승인.
  approvalStage     ApprovalStage @default(CANDIDATE)
  telegramChatId    String? // 카드를 보낸 대화 (화이트리스트된 현표 chat_id)
  telegramMessageId Int? // editMessageText로 같은 메시지를 상태 전이시키기 위한 앵커
  sourceUrlRaw      String? // 현표가 던진 원본 URL (정규화 전) — 감사·디버깅용

  // 봇이 지금 이 딜에 대해 "무엇을 기다리는지". 한 대화에 이 값이 non-null인 딜은 최대 1건이며
  // (setPendingInput이 나머지를 비운다), 그래서 사용자가 보낸 텍스트가 어느 딜의 무엇인지가
  // 모호해지지 않는다. approvalStage만으로 라우팅하면 링크와 훅을 구분할 수 없다.
  pendingInput      PendingInput?

  // 파싱 출처와 채워진 필드 수 — 카드에 "정보를 못 읽었다/일부만 읽었다"를 정확히 표시하기 위해 보존한다.
  parseSource       String? // 'json-ld' | 'opengraph' | 'none'
  parseFieldCount   Int      @default(0)

  salePrice         Int?
  discountRate      Int? // %
  couponCode        String?
  couponDesc        String?
  couponExpiresAt   DateTime?
  finalPrice        Int? // 쿠폰 적용가. null이면 salePrice 사용
  endsAt            DateTime?

  hookLine          String? // AI 초안 → 사람 수정본
  curatorNote       String? // 사이즈 코멘트 등 (168/62 M 정사이즈)
  aiScore           Float?
  priority          Int      @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  curatorLinks CuratorLink[]
  contentCards ContentCard[]
  posts        Post[]
  shortLinks   ShortLink[]

  @@map("deals")
}

enum DealStatus {
  DRAFT
  READY
  PUBLISHED
  EXPIRED
  ARCHIVED
}

enum PendingInput {
  CURATOR_LINK // 큐레이터센터에서 만든 링크를 기다리는 중
  HOOK // 새 훅 문구를 기다리는 중
}

enum ApprovalStage {
  CANDIDATE // 봇이 상품을 파싱해 후보 카드를 띄운 상태
  AWAITING_LINK // 현표가 [관심]을 눌러 큐레이터 링크 붙여넣기를 기다리는 상태
  READY_TO_PUBLISH // 링크 수신 → 카드 렌더 완료, 승인 대기
  APPROVED // 승인됨 (Phase 1에서는 카톡 텍스트 전달까지가 전부)
  SKIPPED // 현표가 스킵 — 스코어링 네거티브 라벨(Phase 3)
}

// ── curator_links ───────────────────────────────────────────────────────
// 큐레이터센터에서 "사람이 수동 생성"한 링크의 저장소. API 생성 불가가 전제(무신사 약관/API 부재).
model CuratorLink {
  id              String   @id @default(uuid())
  dealId          String
  deal            Deal     @relation(fields: [dealId], references: [id])
  variantId       String? // null = 상품 대표 링크 (기본값 — 실사용성 검증 반영: 색상별은 옵트인)
  variant         ProductVariant? @relation(fields: [variantId], references: [id])

  rawUrl          String // 붙여넣은 원본 (utm_term ULID 포함)
  ulid            String? // rawUrl에서 파싱한 utm_term — 정산 매칭 키
  isDefault       Boolean  @default(true) // 상품 대표 링크 여부

  health          LinkHealth @default(UNCHECKED)
  healthCheckedAt DateTime?
  /** 연속 품절 관측 횟수. 일시적 품절(플랩)로 살아있는 링크를 죽이지 않기 위한 카운터 */
  soldoutStreak   Int      @default(0)
  /** 첫 헬스체크 시각. 발행 시각과 동기화되지 않도록 랜덤 오프셋(1~6h)을 더해 정한다 */
  healthCheckAfter DateTime?

  createdAt       DateTime @default(now())

  shortLinks ShortLink[]

  @@map("curator_links")
}

enum LinkHealth {
  OK
  SOLDOUT
  COUPON_EXPIRED
  DEAD
  UNCHECKED
}

// ── content_cards ───────────────────────────────────────────────────────
// 렌더링 결과물. Deal당 채널당 활성 1개, 불변(immutable) + 버전.
model ContentCard {
  id                String   @id @default(uuid())
  dealId            String
  deal              Deal     @relation(fields: [dealId], references: [id])

  channel           Channel
  version           Int      @default(1)

  bodyText          String // 최종 텍스트 (고지 포함)
  charCount         Int
  disclosureOk      Boolean // false면 발행/복사 API가 거부 (불변식)
  truncated         Boolean  @default(false) // 채널 글자수 제약으로 축약 사다리가 적용됐는지
  warnings          String? // 렌더러가 남긴 경고 메시지 배열 (JSON 문자열)
  aiGeneratedFields String? // ['hook_line'] JSON 문자열 — 사람 검토 필요 필드 추적
  approvedAt        DateTime?

  createdAt         DateTime @default(now())

  posts Post[]

  @@unique([dealId, channel, version])
  @@map("content_cards")
}

enum Channel {
  KAKAO_OPEN
  THREADS
  INSTAGRAM_COMMENT
  NOTION
}

// ── posts ───────────────────────────────────────────────────────────────
// 발행 이력. 반자동 채널도 "복사됨"을 기록해 재입력 누락을 없앤다.
model Post {
  id             String      @id @default(uuid())
  contentCardId  String
  contentCard    ContentCard @relation(fields: [contentCardId], references: [id])
  dealId         String
  deal           Deal        @relation(fields: [dealId], references: [id])

  channel        Channel
  mode           PostMode
  status         PostStatus  @default(PENDING)
  publishedAt    DateTime?

  @@map("posts")
}

enum PostMode {
  AUTO_API
  SEMI_COPIED
  SEMI_SENT_TO_ME
}

enum PostStatus {
  PENDING
  SENT
  CONFIRMED
  FAILED
}

// ── short_links ─────────────────────────────────────────────────────────
// docs/02-architecture.md §10.1. 채널별 클릭 계측의 소유권을 확보하고, 품절 시
// 과거 게시물의 링크까지 한 번에 구제하기 위한 앞단 리다이렉트.
//
// 불변식 (docs/03 §5.2·§5.3):
//   - targetUrl은 큐레이터 링크 **원형 무변조**다. 파라미터를 건드리면 링크 변조 금지 조항 위반.
//   - state=DEAD인 링크는 절대 '다른 상품의 커미션 링크'로 자동 착지시키지 않는다.
//     반드시 비커미션 안내 페이지로 보내고, 대안 딜은 사용자가 명시적으로 클릭해야 한다.
model ShortLink {
  id            String      @id @default(uuid())
  code          String      @unique // base62 7자
  dealId        String
  deal          Deal        @relation(fields: [dealId], references: [id])
  curatorLinkId String
  curatorLink   CuratorLink @relation(fields: [curatorLinkId], references: [id])

  /**
   * 어느 지면에 실린 링크인지 — 딜×지면당 1개를 발급해 채널 기여를 최초 클릭 시점에 확정한다.
   * 'hub' | 'notion' | 'kakao_open' | 'threads' … (Channel enum + 링크허브)
   *
   * nullable로 두지 않는 이유: SQL에서 NULL은 서로 다른 값으로 취급되어 복합 유니크가
   * 실제로 강제되지 않는다 — 같은 딜에 hub 링크가 여러 개 생겨도 DB가 막지 못한다.
   */
  surface   String         @default("hub")
  targetUrl String // 큐레이터 링크 원본. 절대 수정하지 않는다.
  state     ShortLinkState @default(ACTIVE)
  createdAt DateTime       @default(now())

  clicks ClickEvent[]

  @@unique([dealId, curatorLinkId, surface])
  @@map("short_links")
}

enum ShortLinkState {
  ACTIVE
  DEAD // 품절·쿠폰 만료 — 안내 페이지로 보낸다
}

// ── click_events ────────────────────────────────────────────────────────
// IP는 저장하지 않는다(개인정보 최소화). 봇 판정에만 쓰고 즉시 버린다.
model ClickEvent {
  id          String    @id @default(uuid())
  shortLinkId String
  shortLink   ShortLink @relation(fields: [shortLinkId], references: [id])
  ts          DateTime  @default(now())
  referer     String?
  /** 'human' | 'bot' — UA 기반 1차 분류. 봇 클릭은 성과 집계에서 제외한다. */
  uaClass     String    @default("human")
  country     String?

  @@index([shortLinkId, ts])
  @@map("click_events")
}

// ── audit_log ───────────────────────────────────────────────────────────
// docs/03-account-safety.md §11. append-only. 목적:
//   ① 플랫폼이 계정을 제재했을 때 "전부 사람이 승인한 공식 API 사용"임을 입증
//   ② 공정위 이슈 시 고지문 삽입 이력 입증
// 절대 규칙: 토큰·개인정보를 기록하지 않는다. 수정·삭제 경로를 만들지 않는다.
model AuditLog {
  id              String   @id @default(uuid())
  ts              DateTime @default(now())
  actor           Actor // 사람이 한 일인가, 시스템이 한 일인가
  action          String // 'deal.captured' | 'deal.approved' | 'card.copied' | 'fetch.blocked' 등
  channel         String? // 해당되는 경우의 채널
  approvalRef     String? // 승인 카드 스냅샷 → 승인 이벤트 → 페이로드 해시를 묶는 체인 키
  payloadHash     String? // SHA-256 — 무엇을 승인했는지의 위변조 불가 증적
  payloadSnapshot String? // 승인 시점의 본문 스냅샷 (JSON 문자열)
  responseCode    Int? // 외부 API 응답 코드
  responseId      String? // 플랫폼이 반환한 게시물 ID
  detail          String? // 사람이 읽을 요약

  @@index([ts])
  @@index([approvalRef])
  @@map("audit_log")
}

enum Actor {
  HUMAN
  SYSTEM
}

// ── fetch_log ───────────────────────────────────────────────────────────
// Fetch Gateway를 통과한 모든 아웃바운드 요청의 기록. 본문은 저장하지 않는다(docs/03 §11).
// "사용자가 명시적으로 요청한 단발 fetch"임을 입증하는 증적이기도 하다 — trigger 필드가 그것.
model FetchLog {
  id           String      @id @default(uuid())
  ts           DateTime    @default(now())
  url          String // 정규화된 요청 URL (ULID/utm 파라미터는 애초에 게이트웨이가 차단)
  host         String
  trigger      FetchTrigger // 무엇이 이 요청을 유발했는가
  outcome      FetchOutcome
  responseCode Int?
  durationMs   Int?
  bytes        Int?
  detail       String? // 차단 사유 등

  @@index([ts])
  @@index([host, ts])
  @@map("fetch_log")
}

enum FetchTrigger {
  USER_URL // 현표가 봇/폼에 직접 던진 URL (Phase 1의 유일한 경로)
  HEALTH_CHECK // 링크 헬스체커 (Phase 2)
  RADAR // 자동 발굴 크롤러 (Phase 3)
  ROBOTS // robots.txt 자체 조회
  WATCH // BF 워치 러너 — VPS 전용, docs/05 §3.2 규율 (W2에서 가동)
}

enum FetchOutcome {
  OK
  BLOCKED_POLICY // 게이트웨이 하드 가드가 막음 (ULID URL, 사설 IP, 호스트 화이트리스트 위반 등)
  BLOCKED_ROBOTS // robots.txt Disallow
  BLOCKED_BUDGET // 레이트리밋/일일 예산 소진
  BLOCKED_CIRCUIT // 서킷 오픈 상태 (이전 차단 감지로 정지 중)
  BOT_CHALLENGE // 캡차·차단 페이지 감지
  HTTP_ERROR
  TIMEOUT
  NETWORK_ERROR
}

// ── circuit_state ───────────────────────────────────────────────────────
// 소스(호스트)별 서킷브레이커. docs/03 §6.2 — 자동 정지, 수동 재개 비대칭.
model CircuitState {
  host          String    @id
  state         Circuit   @default(HEALTHY)
  pausedUntil   DateTime? // 백오프 종료 시각. BLOCKED는 pausedUntil이 없고 사람이 풀어야 한다
  reason        String?
  consecutiveFailures Int  @default(0)
  updatedAt     DateTime  @updatedAt

  @@map("circuit_state")
}

enum Circuit {
  HEALTHY
  DEGRADED // 백오프 중 — 시간이 지나면 자동 회복
  BLOCKED // 차단 감지 — 자동 재개 없음, 사람이 해제해야 함
}

// ── price_snapshots ─────────────────────────────────────────────────────
// docs/05-price-watch.md §4.3 — 상품 가격의 시계열 기록. BF 연도별 비교의 데이터 기반.
// USER_URL·HEALTH_CHECK 스냅샷은 이미 내려받은 페이지의 파싱 결과를 저장할 뿐이라
// 추가 아웃바운드 요청이 0건이다. WATCH만 신규 요청을 만들며 docs/05 §3.2 규율을 따른다.
// 저장 범위는 가격 필드만 — 설명문·이미지를 축적하지 않는다 (docs/03 §4.2 저작권 안전선).
model PriceSnapshot {
  id          String         @id @default(uuid())
  productId   String
  product     Product        @relation(fields: [productId], references: [id])
  capturedAt  DateTime       @default(now())
  listPrice   Int? // 정가
  salePrice   Int? // 행사가(판매가)
  couponPrice Int? // 공개 상품쿠폰가 — 파서 확장(W3) 전에는 항상 null
  source      SnapshotSource
  eventTag    String? // "BF2025" 등. 이벤트 창(policy watch.event.*) 안이면 자동 스탬핑, MANUAL은 직접 지정
  note        String? // MANUAL 입력 근거 (예: "작년 스크린샷 기준")

  @@index([productId, capturedAt])
  @@map("price_snapshots")
}

enum SnapshotSource {
  USER_URL // 봇에 링크를 던진 시점의 파싱 결과 (피기백)
  HEALTH_CHECK // 헬스체커가 내려받은 페이지의 파싱 결과 (피기백)
  WATCH // VPS 워치 러너의 정기 스냅샷 (W2)
  MANUAL // 사람이 직접 입력 (작년 BF가 등)
}

// ── watch_items ─────────────────────────────────────────────────────────
// BF 추적 대상 — 현표가 명시적으로 등록한 상품만. 발굴·카탈로그 수집은 하지 않는다.
// 상한(기본 30)과 만료는 docs/05 §3.2 — 목적이 끝난 상품에 트래픽이 잔존하지 않게 한다.
model WatchItem {
  id        String   @id @default(uuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime // 등록 시 +90일 기본
  active    Boolean  @default(true)

  /**
   * 첫 조회 가능 시각. 등록 시각 + 랜덤 1~6h.
   * 등록과 동시에 조회하면 "현표가 관심을 표한 순간"과 요청 시각이 붙어 지문이 된다 (docs/03 §4.3).
   */
  checkAfter    DateTime
  /**
   * 마지막 조회 시각. **스냅샷으로 대체할 수 없다** — 파싱에 실패하면 스냅샷이 남지 않으므로
   * 스냅샷을 기준으로 삼으면 그 상품이 영원히 "미조회"로 남아 매 사이클 재조회된다(무한 두드림).
   */
  lastCheckedAt DateTime?

  @@map("watch_items")
}

// ── policy ──────────────────────────────────────────────────────────────
// docs/02-architecture.md §13 정책 시트의 DB 형태. "여기 없는 수치를 코드에 하드코딩하지 않는다."
// 코드는 기본값(하드캡)을 함께 갖고, 둘 중 더 보수적인 값을 사용한다(이중화).
model Policy {
  key       String   @id
  value     String // 숫자/불리언도 문자열로 저장 (SQLite/Postgres 공통)
  note      String?
  updatedAt DateTime @updatedAt

  @@map("policy")
}
