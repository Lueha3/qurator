{
  "name": "qurator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "tsx prisma/seed.ts",
    "db:export": "tsx --env-file=.env scripts/export-data.ts",
    "db:import": "tsx --env-file=.env scripts/import-data.ts",
    "db:copy": "tsx --env-file=.env scripts/copy-postgres-data.ts",
    "db:dedupe": "tsx --env-file=.env scripts/dedupe-deals.ts",
    "db:purge-screenshots": "tsx --env-file=.env scripts/purge-screenshot-data.ts",
    "gateway": "tsx --env-file=.env scripts/gateway.ts",
    "push:keys": "tsx scripts/vapid-keys.ts",
    "test": "vitest run",
    "health": "tsx --env-file=.env scripts/health-check.ts",
    "watch": "tsx --env-file=.env scripts/watch.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@prisma/client": "^6.12.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "ipaddr.js": "^2.5.0",
    "next": "16.3.3",
    "prisma": "^6.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
